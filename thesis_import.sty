% thesis_import.sty
%
% Scoped inclusion of a published paper that lives under imported_papers/.
%
% The papers are never edited, so everything that has to change about them has
% to change from the outside. This package does that for the three things that
% break when a paper written as its own project is dropped into a thesis:
%
%   1. File paths. A paper's section file says \input{sections/04_1_foo},
%      relative to the paper's own root. The paper's root is put on LaTeX's
%      file search path for the duration of the chapter.
%   2. Figure paths. Same problem, solved with \graphicspath.
%   3. Label collisions. Six papers carry six sec:introduction labels. Every
%      label and reference inside the block is prefixed with the paper's slug,
%      so the paper's fig:overview becomes acu:fig:overview.
%
% Usage. Declare each paper once in the preamble:
%
%     \DeclareImportedPaper{acu}{imported_papers/ACU_JAIR}{figures}
%
% The third argument is a comma separated list of figure subdirectories inside
% the paper, and may be empty. Then, in the chapter file:
%
%     \begin{importedpaper}{acu}
%       \importsection{sections/02_field_of_agents}
%       \importsection{sections/03_domain_perspective}
%     \end{importedpaper}
%
% To point at something inside the paper from thesis owned text, use the
% prefix: \cref{acu:fig:overview}. Inside the block, \thesisref{...} reaches a
% thesis label without the prefix.
%
% One limitation, enforced by scripts/check_imports.py rather than by LaTeX.
% \input@path is a fallback, not an override: LaTeX looks in the working
% directory first and only then in the paper. So a thesis file whose path
% matches one a paper asks for would shadow the paper's file. The thesis and
% the papers use different naming schemes, and the checker fails if that ever
% stops being true.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis_import}[2026/09/06 v1.0 Scoped inclusion of imported papers]

\RequirePackage{graphicx}

\makeatletter

% ---------------------------------------------------------------------------
% Registry
% ---------------------------------------------------------------------------

\newcommand{\DeclareImportedPaper}[3]{%
  \@namedef{ip@dir@#1}{#2}%
  \@namedef{ip@gfx@#1}{#3}%
}

% ---------------------------------------------------------------------------
% State
% ---------------------------------------------------------------------------

\newcommand{\ip@prefix}{}     % expands to `slug:` inside a block, empty outside
\newcommand{\ip@slug}{}       % the current paper's slug
\newcommand{\ip@dir}{}        % the current paper's directory, with no trailing /
\newcommand{\ip@cwd}{}        % directory of the file being read, below \ip@dir

% \subfile, from the subfiles package, resolves its argument relative to the
% file that calls it rather than to the main document, and a paper written with
% it nests: the root says \subfile{1_introduction/main.tex} and that file then
% says \subfile{new_intro.tex}, meaning 1_introduction/new_intro.tex. Aliasing
% \subfile to \input would look for the second one in the wrong place.
%
% We do not load the subfiles package, because it expects each sub-file to
% carry its own \documentclass wrapper and it would fight kaobook. Tracking the
% directory ourselves is enough, and \filename@parse is the kernel's own path
% splitter. The group keeps \ip@cwd correct as the nesting unwinds.
\newcommand{\ip@subfileclose}[2]{%
  \begingroup
    \filename@parse{#1}%
    \edef\ip@cwd{\ip@cwd\filename@area}%
    \edef\ip@target{\ip@dir/\ip@cwd\filename@base
      \ifx\filename@ext\relax\else.\filename@ext\fi}%
    \expandafter\input\expandafter{\ip@target}%
    % Anything the file opens and does not close has to be closed here, before
    % \endgroup. A file that leaves an \begin{itemize} open otherwise takes
    % this group's \endgroup as its own, \ip@cwd is never restored, and the
    % next \importsection resolves against a doubled path.
    #2%
  \endgroup
}
\newcommand{\ip@subfile}[1]{\ip@subfileclose{#1}{}}
\newif\ifip@inside
\providecommand*\input@path{}

% ---------------------------------------------------------------------------
% Label and reference rewriting
%
% Each patched command is defined once, here, and calls whatever the command
% meant before the block was entered. \let swaps them in and out, so the
% originals survive whatever cleveref and hyperref did to them.
%
% \eqref is deliberately not patched. amsmath defines it in terms of \ref, so
% it picks up the prefix through the patched \ref. Patching it too would
% prefix twice.
% ---------------------------------------------------------------------------

% Strip spaces from a macro's expansion. The kernel's \zap@space is delimited
% by a space, so the call has to supply one, which is why this goes through a
% helper rather than being written inline.
\newcommand{\ip@zap}[1]{\expandafter\zap@space#1 \@empty}

\newcommand{\ip@maplist}[1]{%
  % Prefix every name in a comma separated list, leaving the result in \ip@acc.
  \let\ip@acc\@empty
  \@for\ip@item:=#1\do{%
    \edef\ip@item{\ip@zap\ip@item}%
    \ifx\ip@acc\@empty
      \edef\ip@acc{\ip@prefix\ip@item}%
    \else
      \edef\ip@acc{\ip@acc,\ip@prefix\ip@item}%
    \fi
  }%
}

\NewDocumentCommand{\ip@label}{om}{%
  \IfNoValueTF{#1}%
    {\ip@save@label{\ip@prefix#2}}%
    {\ip@save@label[#1]{\ip@prefix#2}}%
}

% Inside a display, amsmath replaces \label with \label@in@display, which
% stashes the name and re-emits it after the display through amsmath's own
% copy of \label. A patch to \label alone therefore misses every equation
% label, and the reference to it would then be prefixed while the label was
% not. Patching the stash is the right level: it still sees the bare name,
% whether or not cleveref has wrapped the machinery underneath it.
\NewDocumentCommand{\ip@label@in@display}{om}{%
  \IfNoValueTF{#1}%
    {\ip@save@label@in@display{\ip@prefix#2}}%
    {\ip@save@label@in@display[#1]{\ip@prefix#2}}%
}

\NewDocumentCommand{\ip@ref}{sm}{%
  \IfBooleanTF{#1}{\ip@save@ref*{\ip@prefix#2}}{\ip@save@ref{\ip@prefix#2}}%
}

\NewDocumentCommand{\ip@pageref}{sm}{%
  \IfBooleanTF{#1}{\ip@save@pageref*{\ip@prefix#2}}{\ip@save@pageref{\ip@prefix#2}}%
}

\NewDocumentCommand{\ip@nameref}{m}{\ip@save@nameref{\ip@prefix#1}}
\NewDocumentCommand{\ip@autoref}{sm}{%
  \IfBooleanTF{#1}{\ip@save@autoref*{\ip@prefix#2}}{\ip@save@autoref{\ip@prefix#2}}%
}

\NewDocumentCommand{\ip@cref}{sm}{%
  \ip@maplist{#2}%
  \IfBooleanTF{#1}{\ip@save@cref*{\ip@acc}}{\ip@save@cref{\ip@acc}}%
}

\NewDocumentCommand{\ip@Cref}{sm}{%
  \ip@maplist{#2}%
  \IfBooleanTF{#1}{\ip@save@Cref*{\ip@acc}}{\ip@save@Cref{\ip@acc}}%
}

\NewDocumentCommand{\ip@crefrange}{smm}{%
  \IfBooleanTF{#1}%
    {\ip@save@crefrange*{\ip@prefix#2}{\ip@prefix#3}}%
    {\ip@save@crefrange{\ip@prefix#2}{\ip@prefix#3}}%
}

\NewDocumentCommand{\ip@Crefrange}{smm}{%
  \IfBooleanTF{#1}%
    {\ip@save@Crefrange*{\ip@prefix#2}{\ip@prefix#3}}%
    {\ip@save@Crefrange{\ip@prefix#2}{\ip@prefix#3}}%
}

% A caption that contains \ref writes that \ref, unprefixed, into the .lof or
% .lot file. Those files are read back in the front matter, long after the
% block has closed and the prefix has been cleared, so every such reference
% came out undefined. Each entry is therefore wrapped in a command that
% restores the paper's prefix for the length of the entry. The saved commands
% are re-taken here rather than reused, because \ip@save@ref does not exist any
% more by the time the list is typeset.
\newcommand{\ip@withprefix}[2]{{%
  \def\ip@prefix{#1:}%
  \let\ip@save@ref\ref
  \let\ip@save@pageref\pageref
  \let\ref\ip@ref
  \let\pageref\ip@pageref
  \@ifundefined{cref}{}{%
    \let\ip@save@cref\cref \let\ip@save@Cref\Cref
    \let\cref\ip@cref \let\Cref\ip@Cref}%
  #2}}

\newcommand{\ip@acl@wrap}[3]{%
  \begingroup
    \edef\ip@acl{\endgroup
      \noexpand\ip@save@addcontentsline{#1}{#2}%
        {\noexpand\protect\noexpand\ip@withprefix{\ip@slug}{\unexpanded{#3}}}}%
  \ip@acl
}
\let\ip@addcontentsline\ip@acl@wrap

% Section titles reach the table of contents and also the PDF bookmarks, and
% hyperref expands the entry to build the bookmark string. It does not know
% \ip@withprefix and would fail on it, so it is told to take the text and drop
% the prefix, which is right: a bookmark carries no cross reference anyway.
\AtBeginDocument{%
  \@ifundefined{pdfstringdefDisableCommands}{}{%
    \pdfstringdefDisableCommands{\let\ip@withprefix\@secondoftwo}}%
}

% Wide tables are what actually overruns the measure. The figures are clamped
% by \setkeys{Gin} above, but a tabular has no width to clamp: it is as wide as
% its columns make it, and the papers sized their columns for a two column
% template. Wrapping each outermost tabular in an adjustbox shrinks only those
% that do not fit and leaves the rest alone.
%
% The counter is global because an environment is a group, so a nested tabular
% would otherwise not see the outer one and each level would add its own box.
\newcount\ip@tabdepth
\newcommand{\ip@clamptables}{%
  \let\ip@old@tabular\tabular
  \let\ip@old@endtabular\endtabular
  \renewenvironment{tabular}{%
    \global\advance\ip@tabdepth\@ne
    \ifnum\ip@tabdepth=\@ne
      \begin{adjustbox}{max width=\linewidth}%
    \fi
    \ip@old@tabular
  }{%
    \ip@old@endtabular
    \ifnum\ip@tabdepth=\@ne
      \end{adjustbox}%
    \fi
    \global\advance\ip@tabdepth\m@ne
  }%
}

% A longtable is the one table adjustbox cannot help, because it breaks across
% pages and so is never a single box to scale. The ACU survey ships three of
% them, fifteen columns of ticks each, sized for a wide journal template, and
% they ran 182pt past a 304pt measure.
%
% Turning the page is what fixes it. A rotated page gives \textheight, 689pt
% here, which is more than any of them needs, and a rotated appendix table is
% what a reader expects anyway. \pagelayout{wide} was tried first and is not an
% option: it exhausts TeX's main memory in kaobook's output routine. widepar is
% not one either, because longtable measures against the page rather than
% \linewidth and ignores it.
%
% Rotation is declared per file, with \importsectionrotated, rather than
% wrapped around each longtable. Turning the page is a \clearpage at each end,
% so rotating three tables in one file left each of the three subsection
% headings stranded alone on an otherwise empty upright page. Rotating the file
% puts the headings on the rotated pages where they belong and pays the page
% break once.
%
% This leaves each paper's own \tabcolsep alone. With the full rotated measure
% there is no need to tighten anything, and the tables keep the spacing they
% were published with.
% lscape turns the page by setting \vsize to the old \textwidth, which in
% kaobook is only 304pt because the margin column takes another 153pt. Rotated,
% that margin is not a margin any more, it is unused height at the foot of the
% page, and a long table breaks a third early to avoid it. Adding it back gives
% 458pt, which is exactly the space between the two side margins, so the
% rotated block fills the page the same way an upright one does.
\newlength{\ip@lsextra}
\newenvironment{ip@landscape}{%
  \setlength{\ip@lsextra}{\marginparsep}%
  \addtolength{\ip@lsextra}{\marginparwidth}%
  \begin{landscape}%
  % Local, not global. \endlandscape clears the page inside its own group and
  % then restores \vsize and friends from \textheight, so a global advance
  % here would leave every upright page in the thesis 153pt taller.
  \advance\vsize\ip@lsextra
  \advance\textheight\ip@lsextra
  \advance\@colroom\ip@lsextra
  \advance\@colht\ip@lsextra
  % The rotated block is set down from the text block's own left edge, and on
  % a verso page that edge is on the far side of the margin column: there is
  % only \textwidth of paper to the right of it, so the taller block would run
  % off the trim. Shifting it back by the margin puts it in the same place on
  % both sides of the spread.
  \def\LS@rot{\setbox\@outputbox\vbox{\hbox{%
    \ifodd\c@page\else\kern-\ip@lsextra\fi
    \rotatebox{90}{\box\@outputbox}}}}%
}{%
  \end{landscape}%
}


% Swap one command for its patched twin, if the command exists at all.
\newcommand{\ip@patch}[1]{%
  \@ifundefined{#1}{}{%
    \expandafter\let\csname ip@save@#1\expandafter\endcsname\csname #1\endcsname
    \expandafter\let\csname #1\expandafter\endcsname\csname ip@#1\endcsname
  }%
}
\newcommand{\ip@unpatch}[1]{%
  \@ifundefined{ip@save@#1}{}{%
    \expandafter\let\csname #1\expandafter\endcsname\csname ip@save@#1\endcsname
  }%
}

\newcommand{\ip@allcommands}{label,label@in@display,ref,pageref,nameref,%
autoref,cref,Cref,crefrange,Crefrange,addcontentsline}

% Defining one of a paper's labels from thesis owned text, outside any block.
%
% When a chapter drops the paper's discussion and writes its own summary, the
% paper's body still says "as we discuss in Section~\ref{sec:discussion}", and
% the section that reference wants is now the chapter summary. This puts the
% paper's label there. It is not a full importedpaper block, because that ends
% with a \clearpage and would break the page in the middle of a chapter.
%
% Use it only where the thesis owned text really is the replacement for what
% the paper labelled. It is a claim about content, not a way to silence a
% warning.
\newcommand{\importedlabel}[2]{\label{#1:#2}}

% Reaching a thesis label from inside a block.
\NewDocumentCommand{\thesisref}{sm}{%
  \IfBooleanTF{#1}{\ip@plain@ref*{#2}}{\ip@plain@ref{#2}}%
}
\AtBeginDocument{\let\ip@plain@ref\ref}

% ---------------------------------------------------------------------------
% The environment
% ---------------------------------------------------------------------------

\newcommand{\ip@setgraphics}[1]{%
  % Converted figures come first, so a PDF that scripts/convert_eps.py made
  % from an EPS wins over the EPS sitting beside it in the paper.
  \edef\ip@gpath{{generated/imported/\ip@slug/figures/}{\ip@dir/}}%
  \edef\ip@gfxlist{#1}%
  \ifx\ip@gfxlist\@empty\else
    \@for\ip@g:=\ip@gfxlist\do{%
      \edef\ip@g{\ip@zap\ip@g}%
      \ifx\ip@g\@empty\else
        \edef\ip@gpath{\ip@gpath{\ip@dir/\ip@g/}}%
      \fi
    }%
  \fi
  \expandafter\graphicspath\expandafter{\ip@gpath}%
}


% ---------------------------------------------------------------------------
% SHORT FORMS FOR THE LIST OF FIGURES AND THE LIST OF TABLES
%
% Option 2 of 00_ADMIN/06_float_presentation_concept.md. The papers contain
% 211 captions and not one carries LaTeX's short form, so the two lists were
% walls of text. thesis_style.tex clips an over-long entry to one line, which
% is a truncation rather than a summary. Inside a block the caption is still an
% ordinary token list when \caption receives it, so the first sentence can be
% split off there and passed as the optional argument. The clipping stays as
% the fallback for a first sentence that is itself too long.
%
% Two guards, both found by the concept note.
%
% An abbreviation ends the sentence early: "Fig. 2 shows ..." splits at "Fig".
% The candidate is therefore typeset into a box and measured, and one narrower
% than \ip@capmin is extended with the next sentence. Measuring is used rather
% than counting characters because a caption is a token list and may hold
% macros that no string test can see through.
%
% Measuring typesets the candidate, so anything with a side effect is disabled
% first. \label matters most: letting one fire twice is how this repository
% gets a duplicate label.
%
% A caption that already carries a short form is left alone, and so is a
% caption inside a subfigure, which does not belong in the list anyway.
\newsavebox{\ip@capbox}
\newlength{\ip@capmin}
\setlength{\ip@capmin}{5em}
\newif\ifip@capdone

\def\ip@mark{\ip@mark@}

\newcommand{\ip@firstsentence}[1]{%
  \let\ip@cand\@empty
  \ip@capdonefalse
  \ip@fs#1. \ip@mark\ip@stop}

\def\ip@fs#1. #2\ip@stop{%
  \ifx\ip@cand\@empty
    \protected@edef\ip@cand{\unexpanded{#1}}%
  \else
    \protected@edef\ip@cand{\ip@cand. \unexpanded{#1}}%
  \fi
  \def\ip@rest{#2}%
  \ifx\ip@rest\ip@mark
    % No further sentence to take.
    \ip@capdonetrue
  \else
    \begingroup
      \let\label\@gobble \let\index\@gobble \let\footnote\@gobble
      \let\nonumber\relax
      \sbox\ip@capbox{\ip@cand}%
      \ifdim\wd\ip@capbox>\ip@capmin \aftergroup\ip@capdonetrue \fi
    \endgroup
  \fi
  \ifip@capdone\else\ip@fs#2\ip@stop\fi}

% Most of these papers open a caption with the claim in bold, which is the
% convention CLAUDE.md 3.8 asks for and is exactly the short form wanted. The
% period then sits inside the \textbf group, where the sentence splitter
% cannot see it, so that case is taken first: a caption whose very first token
% is \textbf contributes the contents of that group. A bold lead-in too narrow
% to be a sentence, such as a panel label, falls through to the splitter.
\def\ip@bfmark{\ip@bfmark@}
\def\ip@bfprobe#1\textbf#2#3\ip@stop{%
  \def\ip@pre{#1}%
  \def\ip@bf{#2}}

% A cross reference in a float list entry is kept when it resolves and
% dropped when it does not.
%
% Every reference was dropped between 2026-11-14 and 2026-11-16, on the
% grounds that a list of floats is an index and the number points at something
% the reader has not reached. Reading the rendered lists ended that: the cue
% word stays behind when the number goes, so four entries printed "same
% networks as Table ,", "as in Table :", "of Table under" and, three times in
% one entry, "see Equation )". A dangling cue word reads as a fault, and it
% was hidden only while the entries were being clipped.
%
% The one thing worth dropping is a reference whose target the thesis does not
% have. The self-attention paper's eq:weight-update-bilinear-form-prediction
% lives only in a variant the thesis does not import, and printing it here
% would put a second ?? in the document for one upstream defect. So the test
% is whether the label resolves, not whether it is a reference.
%
% The entry in the .lof holds the paper's own unprefixed label, and
% \ip@withprefix has already restored the prefix and the prefixing \ref by
% the time this runs, so the test is on \ip@prefix and the reference is left
% to the \ref that is in force. \ip@slug is not set out here; that is the
% mistake the first version of this made, and it dropped every reference.
%
% On the first pass of a clean build no label resolves yet and every reference
% is dropped. The .lof written then is read back on the next pass, so three
% passes are needed for the lists to settle, which is what build.sh runs.
\providecommand{\ip@prefix}{}
\newcommand{\ip@ifset}[2]{\@ifundefined{r@\ip@prefix#1}{}{#2}}
\newcommand{\ip@shortform}[1]{{%
  \let\ip@sf@ref\ref
  \let\ip@sf@pageref\pageref
  \let\ip@sf@nameref\nameref
  \let\ip@sf@autoref\autoref
  \def\ref##1{\ip@ifset{##1}{\ip@sf@ref{##1}}}%
  \def\pageref##1{\ip@ifset{##1}{\ip@sf@pageref{##1}}}%
  \def\nameref##1{\ip@ifset{##1}{\ip@sf@nameref{##1}}}%
  \def\autoref##1{\ip@ifset{##1}{\ip@sf@autoref{##1}}}%
  \@ifundefined{cref}{}{%
    \let\ip@sf@cref\cref \let\ip@sf@Cref\Cref
    \def\cref##1{\ip@ifset{##1}{\ip@sf@cref{##1}}}%
    \def\Cref##1{\ip@ifset{##1}{\ip@sf@Cref{##1}}}}%
  % \eqref sets its own brackets, so an unresolved one has to take them with
  % it rather than leave "()" behind.
  \def\eqref##1{\ip@ifset{##1}{(\ip@sf@ref{##1})}}%
  \let\crefrange\@gobbletwo \let\Crefrange\@gobbletwo
  #1}}

\newcommand{\ip@caption}{\@ifnextchar[{\ip@save@caption}{\ip@caption@auto}}
\newcommand{\ip@caption@auto}[1]{%
  \ip@bfprobe#1\ip@bfmark\textbf{}\ip@stop
  \ifx\ip@pre\@empty
    \begingroup
      \let\label\@gobble \let\index\@gobble \let\footnote\@gobble
      \sbox\ip@capbox{\ip@bf}%
      \ifdim\wd\ip@capbox>\ip@capmin \aftergroup\ip@capdonetrue
      \else \aftergroup\ip@capdonefalse \fi
    \endgroup
    \ifip@capdone \let\ip@cand\ip@bf \else \ip@firstsentence{#1}\fi
  \else
    \ip@firstsentence{#1}%
  \fi
  \protected@edef\ip@cand{\protect\ip@shortform{\ip@cand}}%
  \expandafter\ip@save@caption\expandafter[\ip@cand]{#1}}

\newenvironment{importedpaper}[1]{%
  \ifip@inside
    \PackageError{thesis_import}{importedpaper cannot be nested}{}%
  \fi
  \@ifundefined{ip@dir@#1}{%
    \PackageError{thesis_import}{Unknown imported paper `#1'}%
      {Declare it with \string\DeclareImportedPaper\space in the preamble.}%
  }{}%
  \ip@insidetrue
  \edef\ip@dir{\@nameuse{ip@dir@#1}}%
  \edef\ip@slug{#1}%
  \edef\ip@prefix{#1:}%
  % Search the paper's own root for \input, after the working directory.
  \let\ip@save@inputpath\input@path
  \edef\input@path{{\ip@dir/}}%
  % Figures.
  \let\ip@save@Ginput@path\Ginput@path
  \ip@setgraphics{\@nameuse{ip@gfx@#1}}%
  % Labels and references.
  \@for\ip@c:=\ip@allcommands\do{\expandafter\ip@patch\expandafter{\ip@c}}%
  % A paper that arrived as one file uses macros its own preamble defined.
  % scripts/split_paper.py carries them across into _macros.tex. Loading them
  % here keeps them inside this environment's group, so two papers may define
  % the same macro name without clashing.
  \InputIfFileExists{generated/imported/#1/_macros.tex}{}{}%
  % Tempting, and it does not work: \pagelayout{wide} here cuts the overfull
  % boxes from 151 to 41, because the papers were typeset for wide templates,
  % but it also exhausts TeX's main memory in kaobook's output routine partway
  % through the COGITAO appendix and produces no PDF at all. The overflow is
  % cosmetic, a failed build is not.
  % The papers were typeset for wider templates, so their figures are sized
  % for a measure this thesis does not have. Clamping here is the one place it
  % can be done: the \includegraphics calls are inside the papers and those we
  % do not touch. An explicit width in the paper still applies, this only
  % stops it exceeding the text block.
  \setkeys{Gin}{max width=\linewidth, max totalheight=0.85\textheight,
    keepaspectratio}%
  % Citations need no patching. kaobiblio sets citestyle=numeric-comp, so
  % \cite, \citep and \parencite all render as [12] and the papers already
  % cite alike whichever command they were written with. \citet stays as it is,
  % because "Smith [12] showed" is a grammatical choice and not a style one.
  % If the thesis ever moves to an author-year style this stops being true and
  % \cite would have to be mapped to \parencite here.
  \ip@clamptables
  % The papers were justified for a wider measure, so a line that fitted there
  % can have no legal break here, and TeX would rather overrun than loosen.
  % \emergencystretch lets it loosen on the passes where nothing else works.
  % It applies inside the block only: thesis prose is written for this measure
  % and should keep failing loudly when a line will not fit.
  \emergencystretch=3em\relax
  % Papers built with the subfiles package.
  \let\ip@save@subfile\subfile
  \let\subfile\ip@subfile
  % Short forms for the float lists, see above. Captions inside a
  % subfigure keep the original, because \subcaption is a separate
  % command and is not patched.
  \let\ip@save@caption\caption
  \let\caption\ip@caption
  \renewcommand{\ip@cwd}{}%
}{%
  % Flush this paper's floats before the next block starts. Without it one
  % paper's deferred figures drift into the next paper's pages, and a long
  % enough queue deadlocks the output routine.
  \clearpage
  \let\subfile\ip@save@subfile
  \let\caption\ip@save@caption
  \@for\ip@c:=\ip@allcommands\do{\expandafter\ip@unpatch\expandafter{\ip@c}}%
  \let\Ginput@path\ip@save@Ginput@path
  \let\input@path\ip@save@inputpath
  \renewcommand{\ip@prefix}{}%
  \ip@insidefalse
}

% One section of the current paper, named relative to the paper's root. For a
% paper that arrived as split section files.
% The optional argument closes what the file leaves open. A published paper
% is not always balanced, and this is how the thesis includes an unbalanced
% one without editing it. scripts/check_imports.py works out what is missing
% and fails if the two disagree, in either direction, so the day the paper is
% fixed upstream the stale closer is reported rather than silently breaking.
\NewDocumentCommand{\importsection}{om}{%
  \ifip@inside\else
    \PackageError{thesis_import}%
      {\string\importsection\space outside an importedpaper environment}{}%
  \fi
  % Routed through \ip@subfile so that \ip@cwd is set to this file's own
  % directory. A paper using \subfile nests relative to the including file, so
  % the tracking has to start here rather than at the first \subfile.
  \IfNoValueTF{#1}{\ip@subfileclose{#2}{}}{\ip@subfileclose{#2}{#1}}%
}

% One part of a paper that arrived as a single file. scripts/split_paper.py
% cuts it at its \section boundaries and writes the pieces to
% generated/imported/<slug>/, which is committed so that Overleaf can build
% without running Python. Name the part without its .tex.
% The same, on a rotated page. For a file whose tables were sized for a
% template far wider than this one. See ip@landscape above for why rotation is
% declared per file rather than per table.
\newcommand{\importsectionrotated}[1]{%
  \begin{ip@landscape}%
  \importsection{#1}%
  \end{ip@landscape}%
}

\newcommand{\importpart}[1]{%
  \ifip@inside\else
    \PackageError{thesis_import}%
      {\string\importpart\space outside an importedpaper environment}{}%
  \fi
  \input{generated/imported/\ip@slug/#1}%
}

% A file whose display equations will not fit the measure, set across the full
% width instead. kaobook's own \pagelayout{wide} gives back the 153pt the
% margin column takes, which is more than any of the overflows measured here.
%
% Declared per file, for the reason rotation is: the layout change is a
% \clearpage at each end, so applying it per equation would strand headings on
% half empty pages.
%
% Tried once for every imported chapter and abandoned, because with all nine
% papers in the build it exhausted TeX's main memory in kaobook's output
% routine and produced no PDF. That was a volume problem. One appendix part of
% one paper is a different proposition, and the build is checked after each
% file is added to this list rather than assumed.
%
% The margin is gone on these pages, so a margin citation has nowhere to go.
% \ts@sidecitefalse turns the margin citations off for the duration, which is
% the right call anyway: the thesis puts a citation in the margin to use the
% margin, and here there is none.
% The same for a paper included section by section.
\newcommand{\importsectionwide}[1]{%
  \pagelayout{wide}%
  \begingroup
    \@ifundefined{ts@sidecitefalse}{}{\ts@sidecitefalse}%
    \importsection{#1}%
  \endgroup
  \pagelayout{margin}%
}

\newcommand{\importpartwide}[1]{%
  \pagelayout{wide}%
  \begingroup
    \@ifundefined{ts@sidecitefalse}{}{\ts@sidecitefalse}%
    \importpart{#1}%
  \endgroup
  \pagelayout{margin}%
}

\makeatother
\endinput
